---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Brush from '../components/ink/Brush.astro';
import Seal from '../components/ink/Seal.astro';
import Button from '../components/Button.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { site } from '../data';

const page = await getEntry('pages', 'how-i-work');
if (!page) throw new Error('src/content/pages/how-i-work.md is missing');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Section class="pb-24">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4">
        A manual for working with me{page.data.updated && <> · updated <FormattedDate date={page.data.updated} /></>}
      </p>
      <h1 class="text-5xl font-medium leading-[1.05] md:text-6xl" data-ink-title>{page.data.title}.</h1>
      <Brush variant={1} />
      <div class="prose prose-lg mt-10">
        <Content />
      </div>
      <div class="mt-14 flex flex-wrap items-center gap-4 border-t border-line pt-8">
        <Seal size={40} stamp />
        <Button href={`mailto:${site.email}`}>Email me</Button>
        <Button href="/stories/" variant="secondary">Read my stories</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
