---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';

const page = await getEntry('pages', 'how-i-work');
if (!page) throw new Error('src/content/pages/how-i-work.md is missing');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  {/* Keep this draft unlisted while Vincent reviews it. */}
  <meta slot="head" name="robots" content="noindex" />
  <PageHeader eyebrow="How I work" title={`${page.data.title}.`} brush={1}>
    {page.data.updated && (
      <p slot="meta" class="mt-3 font-mono text-meta text-muted">Updated <FormattedDate date={page.data.updated} /></p>
    )}
    <div class="prose mt-10">
      <Content />
    </div>
    <a href="/stories/" class="mt-12 inline-block py-2 font-mono text-label ink-link">See my work <span aria-hidden="true">→</span></a>
  </PageHeader>
</BaseLayout>
