---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Brush from '../components/ink/Brush.astro';
import TimelineItem from '../components/experience/TimelineItem.astro';
import Education from '../components/experience/Education.astro';
import Certifications from '../components/experience/Certifications.astro';
import Button from '../components/Button.astro';
import { experience, highlights, skills, cvUrl } from '../data';
import { getStories } from '../lib/stories';

const stories = await getStories();
const storyFor = (jobId: string) => {
  const s = stories.find((st) => st.data.job === jobId);
  return s ? { href: `/stories/${s.id}/`, title: s.data.title } : undefined;
};
---

<BaseLayout
  title="Experience"
  description="Work history of Ting (Vincent) Lu: customer, vendor and partner projects at Tencent, Philips, Amazon and Huawei in the Netherlands."
>
  <Section class="pb-10">
    <div class="max-w-3xl">
      <p class="eyebrow mb-4">Experience</p>
      <h1 class="text-5xl font-medium leading-[1.05] md:text-6xl" data-ink-title>My work so far.</h1>
      <Brush variant={0} />
      <p class="mt-6 text-xl leading-relaxed text-muted">
        The short, CV-style version. Where a job has a longer story behind it, there is a link to it.
      </p>
      {cvUrl && (
        <div class="mt-7">
          <Button href={cvUrl} download>Download the PDF version</Button>
        </div>
      )}
    </div>
  </Section>

  {highlights.length > 0 && (
    <Section tight class="pt-0">
      <ul class="grid gap-px overflow-hidden rounded-md border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {highlights.map((h, i) => (
          <li class="bg-paper p-6" data-reveal style={`--d: ${i * 50}ms`}>
            <p class="font-display text-4xl font-medium text-accent">{h.value}</p>
            <p class="mt-2 leading-snug">{h.label}</p>
            {h.sub && <p class="mt-1 font-mono text-[0.72rem] text-muted">{h.sub}</p>}
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section>
    <ol class="relative border-l border-line md:border-l-0 md:before:absolute md:before:left-[25%] md:before:top-0 md:before:h-full md:before:w-px md:before:bg-line">
      {experience.map((job, i) => <TimelineItem job={job} index={i} story={storyFor(job.id)} />)}
    </ol>
  </Section>

  <Section tight class="border-t border-line">
    <SectionHeading eyebrow="Skills" title="The tools and skills I use most." brush={1} />
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((g, i) => (
        <div data-reveal style={`--d: ${i * 70}ms`}>
          <h3 class="font-mono text-[0.75rem] uppercase tracking-wider text-accent">{g.title}</h3>
          <ul class="mt-4 space-y-2 border-l border-line pl-4">
            {g.items.map((s) => <li class="leading-relaxed">{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section tight class="border-t border-line">
    <SectionHeading eyebrow="Education" title="I studied Dutch first, then business and AI." brush={2} />
    <Education />
  </Section>

  <Section tight class="pb-24">
    <SectionHeading eyebrow="Certifications" title="Certifications." />
    <Certifications />
  </Section>
</BaseLayout>
