---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TimelineItem from '../components/experience/TimelineItem.astro';
import Education from '../components/experience/Education.astro';
import Certifications from '../components/experience/Certifications.astro';
import Button from '../components/Button.astro';
import { experience } from '../data';
import { cvUrl } from '../data';
---

<BaseLayout
  title="Experience"
  description="Work history of Ting (Vincent) Lu: customer, vendor and partner projects at Tencent, Philips, Amazon and Huawei in the Netherlands."
>
  <Section>
    <SectionHeading
      eyebrow="Experience"
      title="My work so far."
      intro="Eight years in the Netherlands as a project manager, product owner and consultant. I have put the work with external vendors and partners first in each role."
    />
    <ol class="relative border-l border-line md:border-l-0 md:before:absolute md:before:left-[25%] md:before:top-0 md:before:h-full md:before:w-px md:before:bg-line">
      {experience.map((job, i) => <TimelineItem job={job} index={i} />)}
    </ol>
    {cvUrl && (
      <div class="mt-4" data-reveal>
        <Button href={cvUrl} download>Download the PDF version</Button>
      </div>
    )}
  </Section>

  <Section tight class="border-t border-line">
    <SectionHeading eyebrow="Education" title="I studied Dutch first, then business and AI." />
    <Education />
  </Section>

  <Section tight class="pb-24">
    <SectionHeading eyebrow="Certifications" title="Certifications." />
    <Certifications />
  </Section>
</BaseLayout>
