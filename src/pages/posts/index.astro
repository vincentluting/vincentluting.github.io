---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Brush from '../../components/ink/Brush.astro';
import PostCard from '../../components/blog/PostCard.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Writing" description="Notes by Ting (Vincent) Lu on AI, on work, and on living between China and the Netherlands.">
  <Section class="pb-24">
    <div class="mb-12 max-w-3xl md:mb-16">
      <p class="eyebrow mb-4">Writing</p>
      <h1 class="text-5xl font-medium leading-[1.05] md:text-6xl" data-ink-title>Some things I have written.</h1>
      <Brush variant={2} />
      <p class="mt-6 text-xl leading-relaxed text-muted">
        Notes on AI, on work, and on living between China and the Netherlands. The oldest ones are from 2024, the first months of my MBA, and are about how the technology works underneath.
      </p>
    </div>
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => <PostCard post={post} index={i} headingLevel={2} />)}
    </div>
  </Section>
</BaseLayout>
