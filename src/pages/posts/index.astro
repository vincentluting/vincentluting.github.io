---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import GridSection from '../../components/GridSection.astro';
import ListRow from '../../components/ListRow.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { site } from '../../data';

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
// Recent notes first; earlier ones (archive: true) stay online at the same
// URL, listed at the end.
const posts = all.filter((p) => !p.data.archive);
const earlier = all.filter((p) => p.data.archive);
---

<BaseLayout title="Blog" description={`Notes by ${site.fullName} on AI, work, and living between China and the Netherlands.`}>
  <PageHeader eyebrow="Blog" title="Notes on AI, work and moving countries" brush={2} />

  {posts.length > 0 && (
    <GridSection title="Recent notes" size="group" rule>
      <ol class="divide-y divide-line border-y border-line">
        {posts.map((post) => (
          <li>
            <ListRow href={`/posts/${post.id}/`} title={post.data.title} description={post.data.description}>
              <FormattedDate slot="meta" date={post.data.date} />
            </ListRow>
          </li>
        ))}
      </ol>
    </GridSection>
  )}

  {earlier.length > 0 && (
    <GridSection title="Earlier notes" size="group" rule>
      <p slot="label" class="mt-2 max-w-sm text-muted">
        From the first months of my MBA in 2024, when I was working out how the technology works underneath.
      </p>
      <ol class="divide-y divide-line border-y border-line">
        {earlier.map((post) => (
          <li>
            <ListRow href={`/posts/${post.id}/`} title={post.data.title} size="lead">
              <FormattedDate slot="meta" date={post.data.date} />
            </ListRow>
          </li>
        ))}
      </ol>
    </GridSection>
  )}
</BaseLayout>
