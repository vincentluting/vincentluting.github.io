---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CaseStudy from '../components/projects/CaseStudy.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { featuredProject, otherProjects } from '../data';
---

<BaseLayout
  title="Projects"
  description="Deep Dive, an AI career assessment platform built end to end, plus selected work projects at Tencent and Philips."
>
  <Section>
    <SectionHeading
      eyebrow="Projects"
      title="Things I have built."
    />
    <CaseStudy project={featuredProject} />
  </Section>

  <Section tight class="border-t border-line pb-24">
    <SectionHeading eyebrow="Selected work" title="Projects from work." />
    <div class="grid gap-6 md:grid-cols-3">
      {otherProjects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </Section>
</BaseLayout>
