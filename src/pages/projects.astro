---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CaseStudy from '../components/projects/CaseStudy.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { featuredProject, otherProjects } from '../data/projects';
---

<BaseLayout
  title="Projects"
  description="Deep Dive, an AI career assessment platform built end to end, plus selected work projects at Tencent and Philips."
>
  <Section>
    <SectionHeading
      eyebrow="Projects"
      title="Things I have built or shipped, from a production AI platform to the automation nobody sees."
    />
    <CaseStudy project={featuredProject} />
  </Section>

  <Section tight class="border-t border-line pb-24">
    <SectionHeading eyebrow="Selected work" title="Smaller in scope, same approach." />
    <div class="grid gap-6 md:grid-cols-3">
      {otherProjects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </Section>
</BaseLayout>
