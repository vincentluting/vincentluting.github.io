---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Brush from '../components/ink/Brush.astro';
import Signature from '../components/ink/Signature.astro';
import Seal from '../components/ink/Seal.astro';
import JsonLd from '../components/JsonLd.astro';
import { resolveImage } from '../lib/images';
import { about, site } from '../data';

const portrait = resolveImage(site.portrait);
---

<BaseLayout
  title="About"
  fullTitle={`About ${site.fullName}`}
  description="How I came to the Netherlands to study Dutch and stayed: where I come from, what I like doing, and life outside work."
>
  <JsonLd
    slot="head"
    data={{
      '@type': 'ProfilePage',
      url: `${site.url}/about/`,
      mainEntity: { '@id': `${site.url}/#person` },
    }}
  />
  <Section>
    <!-- Wide screens: eyebrow, portrait and facts in the left four columns,
         the title and the story in the right eight. Phones: the story first. -->
    <div class="page-grid">
      <p class="eyebrow lg:col-span-4 lg:pt-[1.3rem]">About</p>
      <div class="min-w-0 lg:col-span-8">
        <h1 class="text-h2 font-medium md:text-h1" data-ink-title>From Leiden to here</h1>
        <Brush variant={0} />
      </div>

      <div class="min-w-0 lg:col-span-8 lg:col-start-5 lg:row-start-2">
        <div class="mt-4 max-w-[38rem] space-y-6 leading-[1.7] md:text-lead">
          {about.intro.map((p, i) => (
            <p data-reveal style={`--d: ${i * 60}ms`} class:list={[i === 0 && 'first-letter:float-left first-letter:mr-2 first-letter:font-display first-letter:text-[3.6em] first-letter:leading-[0.85] first-letter:text-accent']}>{p}</p>
          ))}
        </div>
        <Signature class="mt-8 h-20 w-auto max-w-full md:h-24" />
        <div class="mt-8">
          <Button href="/stories/">
            See my work
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </Button>
        </div>
      </div>

      <aside class="mt-10 min-w-0 space-y-9 lg:col-span-4 lg:col-start-1 lg:row-start-2 lg:mt-4">
        <figure class="relative mx-auto max-w-xs sm:-rotate-1 lg:mx-0" data-reveal style="--d: 100ms">
          <div class="deckle bg-paper p-3 shadow-[0_18px_40px_-22px_rgb(0_0_0/0.45)]">
            <Image
              src={portrait}
              alt={site.fullName}
              widths={[256, 320, 512, 640]}
              sizes="(max-width: 23rem) calc(100vw - 3.5rem), 18.5rem"
              loading="eager"
              class="deckle aspect-[4/5] w-full object-cover"
            />
          </div>
          <Seal size={56} stamp class="absolute right-2 -bottom-4" />
        </figure>
        <div data-reveal style="--d: 160ms">
          <h2 class="eyebrow">Languages</h2>
          <ul class="mt-3 divide-y divide-line border-y border-line">
            {site.languages.map((l) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <span>{l.name}</span>
                <span class="text-right font-mono text-meta text-muted">{l.level}</span>
              </li>
            ))}
          </ul>
        </div>
        {about.hobbies.length > 0 && (
          <div data-reveal style="--d: 200ms">
            <h2 class="eyebrow">Outside work</h2>
            <ul class="mt-3 space-y-1.5">
              {about.hobbies.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </Section>
</BaseLayout>
