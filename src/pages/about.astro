---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import Brush from '../components/ink/Brush.astro';
import Signature from '../components/ink/Signature.astro';
import Seal from '../components/ink/Seal.astro';
import JsonLd from '../components/JsonLd.astro';
import { resolveImage } from '../lib/images';
import { about } from '../data';
import { site } from '../data';

const portrait = resolveImage(site.portrait);
---

<BaseLayout
  title="About"
  description="Who Ting (Vincent) Lu is: nine years in the Netherlands, customer and supplier projects at four global companies, and the kind of work he wants to do for the long run."
>
  <JsonLd
    slot="head"
    data={{
      '@type': 'Person',
      name: site.fullName,
      jobTitle: site.role,
      url: `${site.url}/about/`,
      sameAs: [site.linkedin, site.deepDive],
      knowsLanguage: ['en', 'zh', 'nl'],
    }}
  />
  <Section>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">About</p>
        <h1 class="text-5xl font-medium leading-[1.05] md:text-6xl" data-ink-title>
          Hi, I’m <em class="font-normal text-accent">{site.preferredName}</em>.
        </h1>
        <Brush variant={0} />
        <div class="mt-8 space-y-6 text-xl leading-[1.7]">
          {about.intro.map((p, i) => (
            <p data-reveal style={`--d: ${i * 60}ms`} class:list={[i === 0 && 'first-letter:float-left first-letter:mr-2 first-letter:font-display first-letter:text-[3.6em] first-letter:leading-[0.85] first-letter:text-accent']}>{p}</p>
          ))}
        </div>
        <Signature class="mt-8 h-20 w-auto md:h-24" />
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <Button href={`mailto:${site.email}`}>Send me an email</Button>
          <Button href="/how-i-work/" variant="secondary">How I work</Button>
          <Button href={site.linkedin} variant="secondary" external>LinkedIn</Button>
        </div>
      </div>

      <aside class="space-y-10 lg:col-span-5">
        <figure class="relative -rotate-1" data-reveal style="--d: 100ms">
          <div class="deckle bg-paper p-3 shadow-[0_18px_40px_-22px_rgb(0_0_0/0.45)]">
            <Image
              src={portrait}
              alt={`Portrait of ${site.fullName}`}
              width={800}
              densities={[1, 2]}
              class="deckle aspect-[4/5] w-full object-cover"
            />
          </div>
          <Seal size={56} stamp class="absolute -right-4 -bottom-4" />
        </figure>
        <div data-reveal style="--d: 160ms">
          <h2 class="font-mono text-[0.75rem] uppercase tracking-wider text-accent">Languages</h2>
          <ul class="mt-3 divide-y divide-line border-y border-line">
            {site.languages.map((l) => (
              <li class="flex items-center justify-between gap-4 py-3">
                <span class="text-ink">{l.name}</span>
                <span class="text-right font-mono text-[0.75rem] text-muted">{l.level}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal style="--d: 220ms">
          <h2 class="font-mono text-[0.75rem] uppercase tracking-wider text-accent">Outside work</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {about.hobbies.map((h) => <Tag>{h}</Tag>)}
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
