---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import JsonLd from '../components/JsonLd.astro';
import { resolveImage } from '../lib/images';
import { about } from '../data';
import { site } from '../data';

const portrait = resolveImage(site.portrait);
---

<BaseLayout
  title="About"
  description="Who Ting (Vincent) Lu is: nine years from Beijing to Utrecht, project and product management at four global companies, and an MBA in AI."
>
  <JsonLd
    slot="head"
    data={{
      '@type': 'Person',
      name: site.fullName,
      jobTitle: site.role,
      url: `${site.url}/about/`,
      sameAs: [site.linkedin, site.deepDive],
      knowsLanguage: ['en', 'zh', 'nl'],
    }}
  />
  <Section>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4" data-reveal>About</p>
        <h1 class="text-4xl font-medium leading-tight md:text-5xl" data-reveal>
          Hi, I’m Vincent.
        </h1>
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
          {about.intro.map((p, i) => <p data-reveal style={`--d: ${i * 60}ms`}>{p}</p>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <Button href={`mailto:${site.email}`}>Send me an email</Button>
          <Button href={site.linkedin} variant="secondary" external>LinkedIn</Button>
        </div>
      </div>

      <aside class="space-y-10 lg:col-span-5">
        <div data-reveal style="--d: 100ms">
          <Image
            src={portrait}
            alt={`Portrait of ${site.fullName}`}
            width={800}
            densities={[1, 2]}
            class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
          />
        </div>
        <div data-reveal style="--d: 160ms">
          <h2 class="font-sans text-sm font-medium uppercase tracking-[0.14em]">Languages</h2>
          <ul class="mt-3 divide-y divide-line border-y border-line">
            {site.languages.map((l) => (
              <li class="flex items-center justify-between py-3 text-sm">
                <span class="text-ink">{l.name}</span>
                <span class="text-muted">{l.level}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal style="--d: 220ms">
          <h2 class="font-sans text-sm font-medium uppercase tracking-[0.14em]">Outside work</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {about.hobbies.map((h) => <Tag>{h}</Tag>)}
          </div>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
