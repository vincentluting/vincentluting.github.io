---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Hero from '../components/home/Hero.astro';
import MyStory from '../components/home/MyStory.astro';
import StoriesTeaser from '../components/home/StoriesTeaser.astro';
import WritingAndNow from '../components/home/WritingAndNow.astro';
import LookingFor from '../components/home/LookingFor.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Contact from '../components/home/Contact.astro';
import { site } from '../data';
import { education } from '../data';

const person = {
  '@type': 'Person',
  name: site.fullName,
  givenName: 'Ting',
  familyName: 'Lu',
  alternateName: 'Vincent Lu',
  jobTitle: site.role,
  url: site.url,
  image: new URL('/og-default.png', site.url).toString(),
  sameAs: [site.linkedin, site.deepDive],
  knowsLanguage: ['en', 'zh', 'nl'],
  address: { '@type': 'PostalAddress', addressLocality: 'Utrecht', addressCountry: 'NL' },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
};
---

<BaseLayout title={`${site.fullName} · ${site.role} in the Netherlands`} description={site.description}>
  <JsonLd slot="head" data={person} />
  <Hero />
  <MyStory />
  <StoriesTeaser />
  <WritingAndNow />
  <LookingFor />
  <Testimonials />
  <Contact />
</BaseLayout>
