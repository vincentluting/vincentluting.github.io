---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Hero from '../components/home/Hero.astro';
import MyStory from '../components/home/MyStory.astro';
import StoriesTeaser from '../components/home/StoriesTeaser.astro';
import WritingAndNow from '../components/home/WritingAndNow.astro';
import Contact from '../components/home/Contact.astro';
import { resolveImage } from '../lib/images';
import { site } from '../data';

// One Person entity for the whole site. /about/ and every story refer to it
// by its @id, so search engines see one person, not several.
const portrait = await getImage({ src: resolveImage(site.portrait), width: 800, format: 'jpg' });
const personId = `${site.url}/#person`;
const graph = {
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.fullName,
      alternateName: ['Ting Lu', 'Vincent Lu'],
      url: `${site.url}/`,
      publisher: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.fullName,
      givenName: 'Ting',
      familyName: 'Lu',
      alternateName: ['Ting Lu', 'Vincent Lu'],
      jobTitle: site.role,
      description: site.description,
      url: `${site.url}/`,
      image: new URL(portrait.src, site.url).toString(),
      email: `mailto:${site.email}`,
      sameAs: [site.linkedin, 'https://github.com/vincentluting', site.deepDive],
      knowsLanguage: ['zh', 'en', 'nl'],
      address: { '@type': 'PostalAddress', addressLocality: 'Utrecht', addressCountry: 'NL' },
    },
  ],
};
---

<BaseLayout title={`${site.fullName} · Utrecht`} description={site.description}>
  <JsonLd slot="head" data={graph} />
  <Hero />
  <MyStory />
  <WritingAndNow />
  <StoriesTeaser />
  <Contact />
</BaseLayout>
