---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import GridSection from '../../components/GridSection.astro';
import ListRow from '../../components/ListRow.astro';
import DeepDive from '../../components/work/DeepDive.astro';
import { getStories, storyTransition } from '../../lib/stories';
import { about } from '../../data';

const stories = await getStories();
const description = 'Case studies from studio IT, advertising analytics and catalog operations, and a few things I made.';

// The thing I made that links to #deep-dive is shown here as a larger block
// with the demo and a screenshot; the others are ordinary rows.
const isDeepDive = (href: string) => href.endsWith('#deep-dive');
const showDeepDive = about.made.some((m) => isDeepDive(m.href));
const made = about.made.filter((m) => !isDeepDive(m.href));
---

<BaseLayout title="Selected work" description={description}>
  <PageHeader eyebrow="Work" title="Selected work" lead={description} brush={1} />

  {stories.length > 0 && (
    <GridSection title="Case studies" size="group" rule>
      <ol class="divide-y divide-line border-y border-line">
        {stories.map((story) => (
          <li>
            <ListRow
              href={`/stories/${story.id}/`}
              meta={`${story.data.company} · ${story.data.period}`}
              title={story.data.title}
              description={story.data.summary}
              outcome={story.data.highlights?.outcome}
              transitionName={storyTransition(story.id)}
            />
          </li>
        ))}
      </ol>
    </GridSection>
  )}

  {(showDeepDive || made.length > 0) && (
    <GridSection id="made" title="Things I made" size="group" rule>
      <ul class="divide-y divide-line border-y border-line">
        {showDeepDive && <li><DeepDive /></li>}
        {made.map((m) => (
          <li><ListRow href={m.href} title={m.name} description={m.what} size="lead" /></li>
        ))}
      </ul>
    </GridSection>
  )}
</BaseLayout>
