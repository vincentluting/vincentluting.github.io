---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Brush from '../../components/ink/Brush.astro';
import StoryCard from '../../components/stories/StoryCard.astro';
import { getStories } from '../../lib/stories';

const stories = await getStories();
const description = 'Projects across studio IT, advertising analytics and catalog operations.';
---

<BaseLayout title="Selected work" description={description}>
  <Section tight>
    <div class="max-w-3xl">
      <h1 class="text-5xl font-medium leading-[1.05] md:text-6xl" data-ink-title>Selected work</h1>
      <Brush variant={1} />
      <p class="mt-5 text-xl leading-relaxed text-muted">{description}</p>
    </div>
    <ul class="mt-8 grid gap-6 md:mt-10 md:grid-cols-2 lg:grid-cols-3" role="list">
      {stories.map((story, index) => (
        <li><StoryCard story={story} index={index} headingLevel={2} /></li>
      ))}
    </ul>
  </Section>
</BaseLayout>
