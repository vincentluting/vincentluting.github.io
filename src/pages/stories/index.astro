---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Brush from '../../components/ink/Brush.astro';
import StoryCard from '../../components/stories/StoryCard.astro';
import { getStories } from '../../lib/stories';

const stories = await getStories();
---

<BaseLayout
  title="Stories"
  description="Some things that happened at work over the years, what I tried, and what I learned from them."
>
  <Section class="pb-10 md:pb-14">
    <div class="max-w-3xl">
      <p class="eyebrow mb-4">Stories</p>
      <h1 class="text-5xl font-medium leading-[1.05] md:text-6xl" data-ink-title>Stories from work.</h1>
      <Brush variant={1} />
      <p class="mt-6 text-xl leading-relaxed text-muted">
        Some things that happened at work over the years, what I tried, and what I learned from them.
      </p>
    </div>
  </Section>
  <Section tight class="pt-0 pb-24">
    <div class="grid gap-8 md:grid-cols-2">
      {stories.map((s, i) => <StoryCard story={s} index={i} headingLevel={2} />)}
    </div>
  </Section>
</BaseLayout>
