---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import Brush from '../../components/ink/Brush.astro';
import Seal from '../../components/ink/Seal.astro';
import Button from '../../components/Button.astro';
import ListRow from '../../components/ListRow.astro';
import { getStories, storyTransition, type Story } from '../../lib/stories';
import { site } from '../../data';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => ({
    params: { id: story.id },
    props: { story, next: stories[(i + 1) % stories.length] },
  }));
}

interface Props {
  story: Story;
  next: Story;
}
const { story, next } = Astro.props;
const { Content } = await render(story);
const { title, shortTitle, summary, company, role, period, highlights, links } = story.data;
const canonical = new URL(`/stories/${story.id}/`, site.url).toString();
---

<BaseLayout title={shortTitle || title} description={summary} type="article">
  <JsonLd
    slot="head"
    data={{
      '@type': 'Article',
      headline: title,
      description: summary,
      url: canonical,
      mainEntityOfPage: canonical,
      author: { '@id': `${site.url}/#person` },
    }}
  />
  <div class="read-progress" aria-hidden="true"></div>
  <article class="container-page py-12 md:py-16">
    <div class="page-grid">
      <!-- Meta on the left (on one line on phones), the case study on the right. -->
      <div class="lg:col-span-4 lg:pt-[1.3rem]">
        <p class="eyebrow"><a href="/stories/" class="ink-link">Work</a></p>
        <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-meta text-muted lg:flex-col">
          <li>{company}</li>
          <li aria-hidden="true" class="lg:hidden">·</li>
          <li>{period}</li>
          <li aria-hidden="true" class="lg:hidden">·</li>
          <li>{role}</li>
        </ul>
      </div>

      <div class="min-w-0 lg:col-span-8">
        <header class="max-w-[38rem]">
          <h1 class="text-h2 font-medium md:text-h1" style={`view-transition-name: ${storyTransition(story.id)}`} data-ink-title>
            {title}
          </h1>
          <Brush variant={2} />
          <p class="mt-6 text-lead text-muted">{summary}</p>
          {highlights && (
            <dl class="mt-7 space-y-4 border-y border-line py-5">
              <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <dt class="eyebrow sm:pt-1">What I did</dt>
                <dd>{highlights.contribution}</dd>
              </div>
              <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <dt class="eyebrow sm:pt-1">What changed</dt>
                <dd>{highlights.outcome}</dd>
              </div>
            </dl>
          )}
        </header>

        <div class="prose mt-12">
          <Content />
        </div>

        <footer class="mt-16 max-w-[38rem]">
          <p class="flex items-center gap-3 border-t border-line pt-6 text-muted">
            <Seal size={32} stamp />
            <span>Written by <a href="/about/" class="ink-link">{site.fullName}</a>.</span>
          </p>
          {links.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-3">
              {links.map((l) => <Button href={l.href} variant="secondary" external={l.href.startsWith('http')}>{l.label}</Button>)}
            </div>
          )}
          {next.id !== story.id && (
            <div class="mt-8 border-y border-line">
              <ListRow
                href={`/stories/${next.id}/`}
                meta={`Next case study · ${next.data.company}`}
                title={next.data.title}
                headingLevel={2}
                transitionName={storyTransition(next.id)}
              />
            </div>
          )}
          <a href="/stories/" class="mt-6 inline-block py-2 font-mono text-label ink-link">All case studies <span aria-hidden="true">→</span></a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
