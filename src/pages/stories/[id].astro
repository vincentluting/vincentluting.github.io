---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import Brush from '../../components/ink/Brush.astro';
import Seal from '../../components/ink/Seal.astro';
import Button from '../../components/Button.astro';
import { getStories, storyTransition, type Story } from '../../lib/stories';
import { site } from '../../data';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => ({
    params: { id: story.id },
    props: { story, next: stories[(i + 1) % stories.length] },
  }));
}

interface Props {
  story: Story;
  next: Story;
}
const { story, next } = Astro.props;
const { Content } = await render(story);
const { title, shortTitle, summary, company, role, period, highlights, links } = story.data;
const canonical = new URL(`/stories/${story.id}/`, site.url).toString();
---

<BaseLayout title={shortTitle || title} description={summary} type="article">
  <JsonLd
    slot="head"
    data={{
      '@type': 'Article',
      headline: title,
      description: summary,
      url: canonical,
      mainEntityOfPage: canonical,
      author: { '@id': `${site.url}/#person` },
    }}
  />
  <div class="read-progress" aria-hidden="true"></div>
  <article class="container-page py-14 md:py-20">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">
        <a href="/stories/" class="ink-link">Work</a>
        <span aria-hidden="true"> / </span>{company} · {period}
      </p>
      <h1
        class="mt-5 text-4xl font-medium leading-[1.08] md:text-[3.4rem]"
        style={`view-transition-name: ${storyTransition(story.id)}`}
        data-ink-title
      >
        {title}
      </h1>
      <Brush variant={2} />
      <p class="mt-6 text-xl leading-relaxed text-muted">{summary}</p>
      <p class="mt-3 font-mono text-xs leading-relaxed text-muted">{role}</p>
      {highlights && (
        <dl class="mt-7 space-y-4 border-y border-line py-5">
          <div class="grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-4">
            <dt class="font-medium">What I did</dt>
            <dd class="leading-relaxed text-muted">{highlights.contribution}</dd>
          </div>
          <div class="grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-4">
            <dt class="font-medium">What changed</dt>
            <dd class="leading-relaxed text-muted">{highlights.outcome}</dd>
          </div>
        </dl>
      )}
    </header>

    <div class="prose prose-lg mx-auto mt-14 max-w-3xl">
      <Content />
    </div>

    <footer class="mx-auto mt-16 max-w-3xl">
      <div class="flex items-center gap-4 border-t border-line pt-8">
        <Seal size={40} stamp />
        <p class="text-muted">
          Written by <a href="/about/" class="ink-link">{site.fullName}</a>.
        </p>
      </div>
      {links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {links.map((l) => <Button href={l.href} variant="secondary" external={l.href.startsWith('http')}>{l.label}</Button>)}
        </div>
      )}
      {next.id !== story.id && (
        <a href={`/stories/${next.id}/`} class="group sheet mt-10 block p-6 transition-transform hover:-translate-y-0.5">
          <span class="eyebrow">Next case study · {next.data.company}</span>
          <span class="mt-2 block font-display text-2xl font-medium leading-snug group-hover:text-accent">
            {next.data.title} <span aria-hidden="true">→</span>
          </span>
        </a>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <Button href="/stories/" variant="secondary">All case studies</Button>
        <Button href={`mailto:${site.email}`} variant="ghost">Email me about this project</Button>
      </div>
    </footer>
  </article>
</BaseLayout>
