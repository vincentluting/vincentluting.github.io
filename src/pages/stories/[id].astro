---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import Brush from '../../components/ink/Brush.astro';
import Seal from '../../components/ink/Seal.astro';
import Button from '../../components/Button.astro';
import Tldr from '../../components/stories/Tldr.astro';
import { getStories, readingMinutes, storyTransition, type Story } from '../../lib/stories';
import { site } from '../../data';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story, i) => ({
    params: { id: story.id },
    props: { story, next: stories[(i + 1) % stories.length] },
  }));
}

interface Props {
  story: Story;
  next: Story;
}
const { story, next } = Astro.props;
const { Content } = await render(story);
const { title, summary, company, period, job, links } = story.data;
const minutes = readingMinutes(story.body);
const canonical = new URL(`/stories/${story.id}/`, site.url).toString();
---

<BaseLayout title={title} description={summary} type="article">
  <JsonLd
    slot="head"
    data={{
      '@type': 'Article',
      headline: title,
      description: summary,
      url: canonical,
      mainEntityOfPage: canonical,
      author: { '@type': 'Person', name: site.fullName, url: site.url },
    }}
  />
  <article class="container-page py-14 md:py-20">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">
        <a href="/stories/" class="hover:text-ink">Stories</a>
        <span aria-hidden="true"> / </span>{company} · {period}
      </p>
      <h1
        class="mt-5 text-4xl font-medium leading-[1.08] md:text-[3.4rem]"
        style={`view-transition-name: ${storyTransition(story.id)}`}
        data-ink-title
      >
        {title}
      </h1>
      <Brush variant={2} />
      <p class="mt-6 text-xl leading-relaxed text-muted">{summary}</p>
    </header>

    <div class="mx-auto mt-10 max-w-3xl">
      <Tldr story={story} minutes={minutes} />
    </div>

    <div class="prose prose-lg mx-auto mt-14 max-w-3xl">
      <Content />
    </div>

    <footer class="mx-auto mt-16 max-w-3xl">
      <div class="flex items-center gap-4 border-t border-line pt-8">
        <Seal size={40} stamp />
        <p class="text-muted">
          Written by <a href="/about/" class="ink-link">{site.fullName}</a>.
          {job && <> The short version is on my <a href={`/experience/#${job}`} class="ink-link">experience page</a>.</>}
        </p>
      </div>
      {links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {links.map((l) => <Button href={l.href} variant="secondary" external={l.href.startsWith('http')}>{l.label}</Button>)}
        </div>
      )}
      {next.id !== story.id && (
        <a href={`/stories/${next.id}/`} class="group sheet mt-10 block p-6 transition-transform hover:-translate-y-0.5">
          <span class="eyebrow">Next story · {next.data.company}</span>
          <span class="mt-2 block font-display text-2xl font-medium leading-snug group-hover:text-accent">{next.data.title} →</span>
        </a>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <Button href={`mailto:${site.email}`}>Talk to me about this</Button>
        <Button href="/stories/" variant="ghost">All stories</Button>
      </div>
    </footer>
  </article>
</BaseLayout>
