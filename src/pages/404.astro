---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <PageHeader eyebrow="404" title="This page does not exist." lead="The link might be old. Here are a couple of places to go instead.">
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/">Back home</Button>
      <Button href="/stories/" variant="secondary">Work</Button>
    </div>
  </PageHeader>
</BaseLayout>
