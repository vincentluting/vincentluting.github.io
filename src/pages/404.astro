---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <section class="container-page py-32 text-center">
    <p class="eyebrow mb-4">404</p>
    <h1 class="text-4xl font-medium md:text-5xl">This page does not exist.</h1>
    <p class="mt-4 text-muted">The link might be old. Here are a couple of places to go instead.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/">Back home</Button>
      <Button href="/posts/" variant="secondary">Writing</Button>
    </div>
  </section>
</BaseLayout>
