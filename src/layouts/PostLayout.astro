---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import JsonLd from '../components/JsonLd.astro';
import ListRow from '../components/ListRow.astro';
import Brush from '../components/ink/Brush.astro';
import Seal from '../components/ink/Seal.astro';
import { site } from '../data';
import { resolveImage } from '../lib/images';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}
const { post, prev, next } = Astro.props;
const { title, description, date, tags, coverAlt, note } = post.data;
const cover = resolveImage(post.data.cover);

const og = cover ? await getImage({ src: cover, format: 'jpg', width: 1200, quality: 82 }) : undefined;
const ogPath = og?.src ?? '/og-default.png';
const canonical = new URL(`/posts/${post.id}/`, site.url).toString();
---

<BaseLayout title={title} description={description} image={ogPath} type="article" publishedTime={date.toISOString()}>
  <JsonLd
    slot="head"
    data={{
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date.toISOString(),
      image: new URL(ogPath, site.url).toString(),
      url: canonical,
      mainEntityOfPage: canonical,
      author: { '@id': `${site.url}/#person` },
    }}
  />
  <div class="read-progress" aria-hidden="true"></div>
  <article class="container-page py-12 md:py-16">
    <div class="page-grid">
      <!-- Meta on the left (on one line on phones), the post on the right. -->
      <div class="lg:col-span-4 lg:pt-[1.3rem]">
        <p class="eyebrow"><a href="/posts/" class="ink-link">Blog</a></p>
        <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-meta text-muted lg:flex-col">
          <li><FormattedDate date={date} /></li>
          {tags.length > 0 && <li aria-hidden="true" class="lg:hidden">·</li>}
          {tags.length > 0 && <li>{tags.map((t) => `#${t}`).join(' ')}</li>}
        </ul>
      </div>

      <div class="min-w-0 lg:col-span-8">
        <header class="max-w-[38rem]">
          <h1 class="text-h2 font-medium md:text-h1" data-ink-title>{title}</h1>
          <Brush variant={1} />
          <p class="mt-6 text-lead text-muted">{description}</p>
          {note && <p class="mt-4 border-l-2 border-accent pl-3 font-mono text-meta text-muted">{note}</p>}
        </header>

        {cover && (
          <figure class="mt-10" data-reveal style="--d: 80ms">
            <Image src={cover} alt={coverAlt ?? ''} width={1400} densities={[1, 2]} class="deckle aspect-[16/9] w-full object-cover" />
          </figure>
        )}

        <div class="prose mt-12">
          <slot />
        </div>

        <footer class="mt-16 max-w-[38rem]">
          <p class="flex items-center gap-3 border-t border-line pt-6 text-muted">
            <Seal size={32} stamp />
            <span>Written by <a href="/about/" class="ink-link">{site.fullName}</a>.</span>
          </p>
          {(prev || next) && (
            <ul class="mt-8 divide-y divide-line border-y border-line" aria-label="Other posts">
              {prev && <li><ListRow href={`/posts/${prev.id}/`} meta="Older" title={prev.data.title} headingLevel={2} /></li>}
              {next && <li><ListRow href={`/posts/${next.id}/`} meta="Newer" title={next.data.title} headingLevel={2} /></li>}
            </ul>
          )}
          <a href="/posts/" class="mt-6 inline-block py-2 font-mono text-label ink-link">All posts <span aria-hidden="true">→</span></a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
