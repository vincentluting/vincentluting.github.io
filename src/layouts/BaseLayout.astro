---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InkCursor from '../components/InkCursor.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <!-- Filter for the ink-bleed title reveal. The letters are pushed around
         by paper-fibre noise and blurred, then a hard alpha threshold turns
         that into ink soaking into paper; both settle to crisp text. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink-bleed" x="-10%" y="-25%" width="120%" height="150%">
        <feTurbulence type="fractalNoise" baseFrequency="0.018 0.11" numOctaves="3" seed="7" result="fibres" />
        <feDisplacementMap in="SourceGraphic" in2="fibres" scale="16" xChannelSelector="R" yChannelSelector="G" result="wick">
          <animate data-ink-anim attributeName="scale" values="16;5;0" keyTimes="0;0.5;1" dur="1.6s" begin="indefinite" fill="freeze" calcMode="spline" keySplines="0.2 0.7 0.3 1;0.2 0.7 0.3 1" />
        </feDisplacementMap>
        <feGaussianBlur in="wick" stdDeviation="5" result="b">
          <animate data-ink-anim attributeName="stdDeviation" values="5;2;0" keyTimes="0;0.55;1" dur="1.6s" begin="indefinite" fill="freeze" calcMode="spline" keySplines="0.2 0.7 0.3 1;0.2 0.7 0.3 1" />
        </feGaussianBlur>
        <feComponentTransfer in="b">
          <feFuncA type="table" tableValues="0 0 0.9 1 1" />
        </feComponentTransfer>
      </filter>
      <!-- A torn, wicking edge for the cursor's wash. Static. -->
      <filter id="ink-edge" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <InkCursor />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
