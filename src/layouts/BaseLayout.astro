---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <!-- Filter for the ink-bleed title reveal: blur, then a hard alpha threshold,
         so letters look like ink spreading into paper before they settle. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink-bleed" x="-10%" y="-20%" width="120%" height="140%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="b">
          <animate data-ink-anim attributeName="stdDeviation" values="5;2.2;0" keyTimes="0;0.55;1" dur="1.3s" begin="indefinite" fill="freeze" calcMode="spline" keySplines="0.2 0.7 0.3 1;0.2 0.7 0.3 1" />
        </feGaussianBlur>
        <feComponentTransfer in="b">
          <feFuncA type="table" tableValues="0 0 0.9 1 1" />
        </feComponentTransfer>
      </filter>
    </svg>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
