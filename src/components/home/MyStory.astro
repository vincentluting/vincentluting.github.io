---
import Section from '../Section.astro';
import { about } from '../../data';
---

{(about.homeIntro || about.intro[0]) && (
  <Section id="story" tight class="border-t border-line">
    <div class="grid gap-4 md:grid-cols-12 md:gap-10">
      <h2 class="text-3xl font-medium leading-tight md:col-span-4 md:text-[2.6rem]">From Leiden to here</h2>
      <div class="max-w-2xl md:col-span-8">
        <p class="text-xl leading-relaxed">{about.homeIntro || about.intro[0]}</p>
        <a href="/about/" class="mt-4 inline-block py-2 font-mono text-[0.82rem] ink-link">More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </Section>
)}
