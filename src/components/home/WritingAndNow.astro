---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import Brush from '../ink/Brush.astro';
import FormattedDate from '../FormattedDate.astro';
import { now } from '../../data';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const nowPreview = now.sections.slice(0, 3).map((s) => ({ title: s.title, first: s.items[0] })).filter((s) => s.first);
---

<Section id="writing" class="border-t border-line">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <div data-reveal>
        <p class="eyebrow mb-3">Writing</p>
        <h2 class="text-3xl font-medium leading-tight md:text-[2.6rem]" data-split>Things I have written.</h2>
        <Brush variant={2} />
      </div>
      <ol class="mt-8 divide-y divide-line border-y border-line">
        {posts.map((post, i) => (
          <li data-reveal style={`--d: ${i * 70}ms`}>
            <a href={`/posts/${post.id}/`} class="group grid gap-1 py-5 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
              <span class="font-mono text-[0.75rem] text-muted sm:pt-1.5"><FormattedDate date={post.data.date} /></span>
              <span>
                <span class="block font-display text-xl font-medium leading-snug transition-colors group-hover:text-accent">{post.data.title}</span>
                <span class="mt-1 line-clamp-2 block text-muted">{post.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <div class="mt-6" data-reveal>
        <a href="/posts/" class="group font-mono text-[0.82rem] ink-link">
          All writing <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <aside class="lg:col-span-5" data-reveal data-tilt style="--d: 120ms">
      <a href="/now/" class="group sheet block rotate-[0.6deg] p-6 transition-[rotate] duration-500 ease-out-soft hover:rotate-0 md:p-8" data-cursor="Now">
        <p class="eyebrow flex items-center justify-between">
          <span>Now</span>
          <span>updated <FormattedDate date={now.updated} /></span>
        </p>
        <dl class="mt-6 space-y-5">
          {nowPreview.map((s) => (
            <div>
              <dt class="font-mono text-[0.72rem] uppercase tracking-wider text-accent">{s.title}</dt>
              <dd class="mt-1 text-lg leading-relaxed">{s.first}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 font-mono text-[0.78rem] text-muted transition-colors group-hover:text-ink">
          More on my now page <span aria-hidden="true">→</span>
        </p>
      </a>
    </aside>
  </div>
</Section>
