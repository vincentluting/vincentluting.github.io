---
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import { skills } from '../../data';
---

<Section id="skills">
  <SectionHeading
    eyebrow="Skills"
    title="The tools and skills I use most."
  />
  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {skills.map((g, i) => (
      <div data-reveal style={`--d: ${i * 70}ms`}>
        <h3 class="font-sans text-sm font-medium uppercase tracking-[0.14em] text-ink">{g.title}</h3>
        <ul class="mt-4 space-y-2 border-l border-line pl-4 text-muted">
          {g.items.map((s) => <li class="leading-relaxed">{s}</li>)}
        </ul>
      </div>
    ))}
  </div>
</Section>
