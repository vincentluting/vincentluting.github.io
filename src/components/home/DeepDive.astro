---
import { Image } from 'astro:assets';
import report from '../../assets/uploads/deep-dive-report.webp';
import { site } from '../../data';
import Section from '../Section.astro';
import Button from '../Button.astro';
---

<Section id="deep-dive" tight class="scroll-mt-16 border-t border-line">
  <div class="sheet grid items-center gap-7 p-5 sm:p-7 md:grid-cols-[minmax(0,4fr)_minmax(0,5fr)] md:gap-8 lg:p-10">
    <div>
      <p class="eyebrow mb-3 text-accent-ink">MBA thesis project</p>
      <h2 class="text-4xl font-medium leading-tight md:text-5xl">Deep Dive</h2>
      <p class="mt-3 text-xl leading-snug">A career exploration tool for people thinking about their next move.</p>
      <p class="mt-3 max-w-lg text-lg leading-snug text-muted">I designed the assessment and the experience, then built and tested the product with AI-assisted development.</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
        <Button href={site.deepDive} external>Try Quick Dive <span aria-hidden="true">↗</span></Button>
        <a href="https://github.com/vincentluting/DeepDive#readme" class="py-2 font-mono text-[0.8rem] ink-link">Project and research</a>
      </div>
    </div>
    <figure>
      <Image
        src={report}
        alt="Example Deep Dive report showing suggested career directions and why they may fit."
        widths={[384, 640, 960, 1280]}
        sizes="(min-width: 64rem) 560px, (min-width: 48rem) 50vw, 85vw"
        class="h-auto w-full rounded border border-line"
      />
      <figcaption class="mt-2 text-right font-mono text-[0.75rem] text-muted">Example career report</figcaption>
    </figure>
  </div>
</Section>
