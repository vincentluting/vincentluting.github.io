---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';
import Button from '../Button.astro';
import InkWash from '../ink/InkWash.astro';
import Seal from '../ink/Seal.astro';
import { site } from '../../data';

const portrait = resolveImage(site.portrait);
---

<InkWash class="border-b border-line">
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24" data-hero>
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7" data-hero-text>
        <p class="eyebrow mb-6">{site.tagline}</p>
        <h1 class="text-5xl font-medium leading-[0.98] sm:text-7xl md:text-[5.6rem]" data-ink-title>
          Hi, I’m <em class="font-normal text-accent">{site.preferredName}</em>.
        </h1>
        <p class="mt-5 max-w-xl text-xl leading-relaxed text-muted md:mt-7 md:text-2xl md:leading-snug">{site.headline}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href="/about/">
            My story
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </Button>
          <Button href="/#contact" variant="secondary">Say hello</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <figure class="relative mx-auto max-w-sm rotate-[1.2deg] lg:max-w-none" data-hero-sheet>
          <div class="scroll-unroll deckle bg-paper p-3 shadow-[0_18px_40px_-22px_rgb(0_0_0/0.45)]">
            <Image
              src={portrait}
              alt={site.fullName}
              width={880}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
              class="deckle aspect-[4/5] w-full object-cover object-top"
            />
          </div>
          <Seal size={64} stamp class="absolute -bottom-5 -left-2 sm:-left-5" label="Seal with the initials TL" />
          <figcaption class="mt-4 text-right font-mono text-[0.75rem] text-muted">Utrecht, 2026</figcaption>
        </figure>
      </div>
    </div>
  </section>
</InkWash>
