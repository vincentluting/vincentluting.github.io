---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';
import Button from '../Button.astro';
import InkWash from '../ink/InkWash.astro';
import Seal from '../ink/Seal.astro';
import { site, cvUrl } from '../../data';

const portrait = resolveImage(site.portrait);
const years = new Date().getFullYear() - 2018;
// The ten-second version, for anyone who is busy.
const facts = [
  ['Role', site.role],
  ['Experience', `${years} years in the Netherlands`],
  ['Companies', site.companies.filter((c) => !/university/i.test(c)).join(' · ')],
  ['Languages', site.languages.map((l) => l.name).join(' · ')],
  ['Based in', site.location],
];
---

<InkWash class="border-b border-line">
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-6">{site.tagline}</p>
        <h1 class="text-6xl font-medium leading-[0.98] sm:text-7xl md:text-[5.6rem]" data-ink-title>
          Hi, I’m <em class="font-normal text-accent">{site.preferredName}</em>.
        </h1>
        <p class="mt-6 max-w-xl text-xl leading-relaxed text-muted md:text-2xl md:leading-snug">{site.headline}</p>

        <dl class="mt-9 grid max-w-xl gap-x-6 gap-y-2 border-y border-line/80 py-5 grid-cols-[6.2rem_1fr] font-mono text-[0.78rem] sm:grid-cols-[7rem_1fr] sm:text-[0.8rem]">
          {facts.map(([k, v]) => (
            <>
              <dt class="uppercase tracking-wider text-muted">{k}</dt>
              <dd class="text-ink">{v}</dd>
            </>
          ))}
        </dl>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href="/stories/">
            Read my stories
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </Button>
          <Button href={`mailto:${site.email}`} variant="secondary">Email me</Button>
          <Button href={site.linkedin} variant="secondary" external>LinkedIn</Button>
          {cvUrl && <Button href={cvUrl} variant="ghost" download>Download CV</Button>}
        </div>

        {(site.availability || site.workAuthorization) && (
          <p class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.78rem] text-muted">
            <span class="inline-flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-60 motion-safe:animate-ping"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
              </span>
              {site.availability}
            </span>
            {site.workAuthorization && <span aria-hidden="true">·</span>}
            {site.workAuthorization && <span>{site.workAuthorization}</span>}
          </p>
        )}
      </div>

      <div class="lg:col-span-5">
        <figure class="relative mx-auto max-w-sm rotate-[1.2deg] lg:max-w-none">
          <div class="deckle bg-paper p-3 shadow-[0_18px_40px_-22px_rgb(0_0_0/0.45)]">
            <Image
              src={portrait}
              alt={`Portrait of ${site.fullName}`}
              width={880}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
              class="deckle aspect-[4/5] w-full object-cover object-top"
            />
          </div>
          <Seal size={64} stamp class="absolute -bottom-5 -left-2 sm:-left-5" label="Seal with the initials TL" />
          <figcaption class="mt-4 text-right font-mono text-[0.72rem] text-muted">Utrecht, 2026</figcaption>
        </figure>
      </div>
    </div>
  </section>
</InkWash>
