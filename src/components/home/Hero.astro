---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';
import Button from '../Button.astro';
import InkWash from '../ink/InkWash.astro';
import Seal from '../ink/Seal.astro';
import { site } from '../../data';

const portrait = resolveImage(site.portrait);
---

<InkWash class="border-b border-line">
  <section class="container-page py-10 sm:py-14 lg:py-20" data-hero>
    <!-- The same 12 columns as the page grid: text in eight, the portrait in four. -->
    <div class="grid items-center gap-8 sm:grid-cols-12 sm:gap-x-6 md:gap-x-8 lg:gap-x-12">
      <div class="sm:col-span-8">
        <p class="eyebrow mb-5">{site.role} <span aria-hidden="true">·</span> {site.tagline}</p>
        <h1 class="text-h1 font-medium lg:text-display">
          Hi, I’m <em class="font-normal text-accent">{site.preferredName}</em>.
        </h1>
        <p class="mt-4 max-w-2xl text-title font-medium md:mt-6 md:text-h2">{site.headline}</p>
        {site.heroIntro && <p class="mt-4 max-w-xl text-muted md:text-lead">{site.heroIntro}</p>}

        <div class="mt-6 flex flex-wrap items-center gap-3 md:mt-8">
          <Button href="#work">
            Explore my work
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </Button>
          <Button href="#contact" variant="secondary">Get in touch</Button>
        </div>
      </div>

      <div class="px-3 sm:col-span-4 sm:px-0">
        <figure class="relative w-full max-w-44 rotate-[1.2deg] sm:ml-auto sm:max-w-[22rem]" data-hero-sheet>
          <div class="deckle bg-paper p-2 sm:p-3">
            <Image
              src={portrait}
              alt={site.fullName}
              widths={[192, 352, 512, 704]}
              sizes="(min-width: 64rem) 330px, (min-width: 40rem) 30vw, 176px"
              loading="eager"
              class="deckle aspect-square w-full object-cover object-[center_30%] sm:aspect-[4/5] sm:object-top"
            />
          </div>
          <Seal size={48} class="absolute -right-2 -bottom-2 -rotate-4 sm:right-auto sm:-bottom-3 sm:-left-3" />
        </figure>
      </div>
    </div>
  </section>
</InkWash>
