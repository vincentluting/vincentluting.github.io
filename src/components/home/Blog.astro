---
import { getCollection } from 'astro:content';
import GridSection from '../GridSection.astro';
import ListRow from '../ListRow.astro';
import FormattedDate from '../FormattedDate.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.archive))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

{posts.length > 0 && (
  <GridSection id="blog" eyebrow="Blog" title="Notes on AI, work and moving countries" rule>
    <ol class="divide-y divide-line border-y border-line">
      {posts.map((post) => (
        <li>
          <ListRow href={`/posts/${post.id}/`} title={post.data.title} description={post.data.description}>
            <FormattedDate slot="meta" date={post.data.date} />
          </ListRow>
        </li>
      ))}
    </ol>
    <a href="/posts/" class="mt-6 inline-block py-2 font-mono text-label ink-link">All posts <span aria-hidden="true">→</span></a>
  </GridSection>
)}
