---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import Brush from '../ink/Brush.astro';
import FormattedDate from '../FormattedDate.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Section id="blog" class="border-t border-line">
  <div class="max-w-4xl">
    <div data-reveal>
      <p class="eyebrow mb-3">Blog</p>
      <h2 class="text-3xl font-medium leading-tight md:text-[2.6rem]" data-split>Notes on AI, work and moving countries.</h2>
      <Brush variant={2} />
    </div>
    <ol class="mt-8 divide-y divide-line border-y border-line">
      {posts.map((post, i) => (
        <li data-reveal style={`--d: ${i * 70}ms`}>
          <a href={`/posts/${post.id}/`} class="group grid gap-1 py-5 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
            <span class="font-mono text-[0.75rem] text-muted sm:pt-1.5"><FormattedDate date={post.data.date} /></span>
            <span>
              <span class="block font-display text-xl font-medium leading-snug transition-colors group-hover:text-accent">{post.data.title}</span>
              <span class="mt-1 line-clamp-2 block text-muted">{post.data.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <div class="mt-6" data-reveal>
      <a href="/posts/" class="group font-mono text-[0.82rem] ink-link">
        All posts <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</Section>
