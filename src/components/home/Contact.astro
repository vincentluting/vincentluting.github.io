---
import Button from '../Button.astro';
import CopyEmail from '../CopyEmail.astro';
import { site } from '../../data';
---

<section id="contact" class="scroll-mt-16 border-t border-line">
  <div class="container-page grid gap-4 py-12 md:grid-cols-12 md:gap-10 md:py-16">
    <h2 class="text-4xl font-medium leading-tight md:col-span-4 md:text-[2.6rem]">Get in touch</h2>
    <div class="max-w-2xl md:col-span-8">
      <p class="text-xl leading-relaxed">Have a project in mind or something you’d like to talk about? You can write in English, Dutch or Mandarin. I’m also up for a coffee in Utrecht.</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href={`mailto:${site.email}`}>Email me</Button>
        <Button href={site.linkedin} variant="secondary" external>LinkedIn</Button>
      </div>
      <CopyEmail class="mt-3" />
    </div>
  </div>
</section>
