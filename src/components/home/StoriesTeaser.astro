---
import Section from '../Section.astro';
import Brush from '../ink/Brush.astro';
import { getStories } from '../../lib/stories';

// A quiet list, not a showcase: the stories are there for whoever is curious.
const stories = await getStories();
---

{stories.length > 0 && (
  <Section id="stories" class="border-t border-line">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow mb-3">From work</p>
        <h2 class="text-3xl font-medium leading-tight md:text-[2.6rem]" data-split>A few stories from work.</h2>
        <Brush variant={1} />
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Some things that happened at work, and what I learned from them.
        </p>
      </div>
      <ol class="divide-y divide-line border-y border-line lg:col-span-8">
        {stories.map((s, i) => (
          <li data-reveal style={`--d: ${i * 60}ms`}>
            <a href={`/stories/${s.id}/`} class="group grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <span class="font-mono text-[0.8rem] text-muted sm:pt-1.5">{s.data.company} · {s.data.period}</span>
              <span class="block font-display text-xl font-medium leading-snug transition-colors group-hover:text-accent">{s.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Section>
)}
