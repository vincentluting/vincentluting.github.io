---
import Section from '../Section.astro';
import Brush from '../ink/Brush.astro';
import { getStories } from '../../lib/stories';

const stories = await getStories();
---

{stories.length > 0 && (
  <Section id="stories" tight class="scroll-mt-16">
    <div class="grid gap-7 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <h2 class="text-4xl font-medium leading-tight md:text-[2.6rem]">Selected work</h2>
        <Brush variant={1} />
        <a href="/stories/" class="mt-4 inline-block py-2 font-mono text-[0.82rem] ink-link">All work stories <span aria-hidden="true">→</span></a>
      </div>
      <ol class="divide-y divide-line border-y border-line lg:col-span-8">
        {stories.slice(0, 3).map((story) => (
          <li>
            <a href={`/stories/${story.id}/`} data-ink-spread class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 rounded-sm py-4 sm:gap-6 sm:py-5">
              <span>
                <span class="font-mono text-[0.75rem] text-muted">{story.data.company}</span>
                <span class="mt-1 block text-xl font-medium leading-snug transition-colors group-hover:text-accent sm:text-[1.35rem]">{story.data.shortTitle || story.data.title}</span>
                {story.data.highlights?.outcome && <span class="mt-1 block text-base leading-snug text-muted">{story.data.highlights.outcome}</span>}
              </span>
              <span class="text-accent transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Section>
)}
