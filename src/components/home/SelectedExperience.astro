---
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Tag from '../Tag.astro';
import { featuredExperience } from '../../data';
---

<Section id="experience">
  <SectionHeading
    eyebrow="Selected experience"
    title="Where I have worked, and what I delivered."
    intro="Four companies with very different cultures. The parts I am proudest of are the ones where I worked directly with vendors, partners and client teams and saw the result go live."
  />
  <ol class="divide-y divide-line border-t border-line">
    {featuredExperience.map((job, i) => (
      <li class="grid gap-4 py-8 md:grid-cols-12 md:gap-8 md:py-10" data-reveal style={`--d: ${i * 60}ms`}>
        <div class="md:col-span-3">
          <p class="font-display text-2xl">{job.company}</p>
          <p class="mt-1 text-sm text-muted">{job.start} – {job.end}</p>
          <p class="text-sm text-muted">{job.location}</p>
        </div>
        <div class="md:col-span-9">
          <h3 class="font-sans text-lg font-medium tracking-normal">{job.role}</h3>
          <ul class="mt-3 space-y-2 text-muted">
            {(job.highlightIdx ?? [0, 1]).map((idx) => (
              <li class="flex gap-3 leading-relaxed">
                <span aria-hidden="true" class="mt-[0.7em] h-1 w-1 shrink-0 rounded-full bg-accent"></span>
                <span>{job.bullets[idx]}</span>
              </li>
            ))}
          </ul>
          {job.tags && (
            <div class="mt-4 flex flex-wrap gap-2">
              {job.tags.map((t) => <Tag>{t}</Tag>)}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
  <div class="mt-8" data-reveal>
    <a href="/experience/" class="group inline-flex items-center gap-2 text-sm font-medium text-ink">
      Full experience, education and certifications
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</Section>
