---
/**
 * A painting hidden under the paper of the whole page. Moving the cursor
 * works like a wet brush that uncovers it for a few seconds (WebGL, see
 * src/scripts/fluid-ink.ts, mode "page"). The layer is fixed behind the
 * content, and the long handscroll slides from its right end to its left as
 * the page scrolls, the way a handscroll is read. Sheets, the portrait and
 * the header sit on top of it, like paper laid over the painting.
 *
 * The painting: Huang Gongwang, "Dwelling in the Fuchun Mountains" (1350),
 * a section of the Wuyong scroll. Public domain, via Wikimedia Commons
 * (File:富春山居圖(無用師卷).jpg).
 */
import painting from '../../assets/ink/fuchun-scroll.webp';
---

<fluid-ink class="page-ink" data-mode="page" data-auto="0" data-clear="0" data-painting={painting.src} aria-hidden="true"></fluid-ink>

<script>
  import '../../scripts/fluid-ink';
</script>

<style>
  .page-ink {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    pointer-events: none;
    /* Softer than in a picture frame: text may sit on top of it. */
    --ink-reveal-opacity: 0.5;
  }
  :global(.dark) .page-ink {
    --ink-reveal-opacity: 0.62;
  }
  :global(html[data-motion='off']) .page-ink {
    display: none;
  }
</style>
