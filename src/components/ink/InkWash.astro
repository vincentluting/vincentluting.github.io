---
/**
 * A band of paper with an ink painting in it: static mountains in mist, and
 * live ink moving through water on top (WebGL, see src/scripts/fluid-ink.ts).
 * The static wash is what visitors see without WebGL2, on phones, with
 * motion off, and while the simulation starts up.
 */
import InkMountains from './InkMountains.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['ink', className]}>
  <div class="ink__fallback" aria-hidden="true"></div>
  <InkMountains />
  <fluid-ink class="ink__sim" data-strength="1" data-auto="1" data-clear="0.42" aria-hidden="true"></fluid-ink>
  <div class="ink__content">
    <slot />
  </div>
</div>

<script>
  import '../../scripts/fluid-ink';
</script>

<style>
  .ink {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .ink__fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(34% 44% at 80% 34%, color-mix(in oklab, var(--ink-wash) 18%, transparent), transparent 72%),
      radial-gradient(9% 12% at 91% 60%, color-mix(in oklab, var(--ink-red) 22%, transparent), transparent 70%),
      radial-gradient(30% 34% at 64% 70%, color-mix(in oklab, var(--ink-pigment) 7%, transparent), transparent 72%);
    transition: opacity 2s ease;
  }
  /* Once live ink is painting, the static wash gives way to it. */
  .ink:has(fluid-ink[data-ink-active]) .ink__fallback {
    opacity: 0;
  }
  .ink__sim {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }
  /* The canvas is opaque, so lay the paper grain back over it. */
  .ink__sim::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--paper-fibres), var(--paper-grain);
    background-size: 640px 640px, 220px 220px;
    pointer-events: none;
  }
  :global(html[data-motion='off']) .ink__sim {
    display: none;
  }
  .ink__content {
    position: relative;
    z-index: 2;
    /* Let the cursor reach the ink; links and buttons opt back in. */
    pointer-events: none;
  }
  .ink__content :global(a),
  .ink__content :global(button),
  .ink__content :global(img),
  .ink__content :global(p),
  .ink__content :global(h1) {
    pointer-events: auto;
  }
</style>
