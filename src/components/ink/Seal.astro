---
/**
 * A small vermilion name seal with the initials VL, like a stamp pressed onto
 * paper. `stamp` makes it press in when it scrolls into view.
 */
interface Props {
  size?: number;
  stamp?: boolean;
  class?: string;
  label?: string;
}
const { size = 40, stamp = false, class: className = '', label } = Astro.props;
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['seal shrink-0 text-accent', stamp && 'seal-stamp', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <filter id={id} x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" result="d" />
      <feComponentTransfer in="n" result="speck">
        <feFuncA type="discrete" tableValues="1 1 1 1 1 1 0 1" />
      </feComponentTransfer>
      <feComposite in="d" in2="speck" operator="in" />
    </filter>
  </defs>
  <g filter={`url(#${id})`}>
    <rect x="4" y="4" width="56" height="56" rx="7" fill="currentColor" />
    <rect x="9" y="9" width="46" height="46" rx="4" fill="none" stroke="var(--paper)" stroke-width="1.6" />
    <text
      x="32"
      y="41.5"
      text-anchor="middle"
      fill="var(--paper)"
      font-family="Newsreader Variable, Georgia, serif"
      font-size="25"
      font-weight="600"
      letter-spacing="-0.5">VL</text>
  </g>
</svg>
