---
import { signature, signatureBox } from '../../lib/shapes';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class:list={['signature text-ink', className]} viewBox={signatureBox} role="img" aria-label="Signed, Ting">
  <path d={signature} fill="currentColor"></path>
</svg>
