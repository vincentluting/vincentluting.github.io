---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  external?: boolean;
  download?: boolean;
  class?: string;
}
const { href, variant = 'primary', external = false, download = false, class: className = '' } = Astro.props;

const base =
  'group inline-flex items-center gap-2 rounded-full font-mono text-[0.82rem] tracking-wide transition-all duration-300 ease-out-soft focus-visible:outline-none';
const variants = {
  primary: 'px-5 py-2.5 bg-ink text-paper hover:bg-accent hover:text-paper hover:-rotate-1 shadow-sm',
  secondary: 'px-5 py-2.5 border border-ink/25 bg-paper/60 text-ink hover:border-ink hover:bg-paper',
  ghost: 'px-1 py-2.5 text-ink underline decoration-accent/60 decoration-[1.5px] underline-offset-4 hover:text-accent',
};
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? '' : undefined}
>
  <slot />
</a>
