---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import { resolveImage } from '../../lib/images';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
  headingLevel?: 2 | 3;
}
const { post, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
const href = `/posts/${post.id}/`;
const cover = resolveImage(post.data.cover);
---

<article class="group flex flex-col" data-drop>
  <a href={href} class="deckle block overflow-hidden bg-surface" tabindex="-1" aria-hidden="true">
    {cover ? (
      <Image
        src={cover}
        alt={post.data.coverAlt ?? ''}
        width={720}
        densities={[1, 2]}
        class="aspect-[16/10] w-full object-cover grayscale-[0.7] sepia-[0.3] contrast-[1.05] transition-[scale,filter] duration-1000 ease-out-soft group-hover:scale-[1.04] group-hover:grayscale-0 group-hover:sepia-0 group-hover:contrast-100"
      />
    ) : (
      <div class="aspect-[16/10] w-full"></div>
    )}
  </a>
  <div class="mt-5">
    <p class="font-mono text-[0.75rem] text-muted">
      <FormattedDate date={post.data.date} />
    </p>
    <H class="mt-2 text-xl font-medium leading-snug">
      <a href={href} class="transition-colors group-hover:text-accent">{post.data.title}</a>
    </H>
    <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
  </div>
</article>
