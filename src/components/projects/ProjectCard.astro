---
import Tag from '../Tag.astro';
import type { Project } from '../../data/types';

interface Props {
  project: Project;
  index?: number;
}
const { project: p, index = 0 } = Astro.props;
---

<article
  id={p.id}
  class="flex h-full flex-col rounded-2xl border border-line bg-surface p-7 transition-colors hover:border-ink/40"
  data-reveal
  style={`--d: ${index * 70}ms`}
>
  <p class="eyebrow">{p.kicker}</p>
  <h3 class="mt-3 text-2xl font-medium leading-snug">{p.title}</h3>
  <p class="mt-1 text-sm text-muted">{p.period}</p>
  <p class="mt-4 flex-1 leading-relaxed text-muted">{p.summary}</p>
  {p.stack && (
    <div class="mt-5 flex flex-wrap gap-2">
      {p.stack.map((s) => <Tag>{s}</Tag>)}
    </div>
  )}
  {p.links && (
    <div class="mt-5 flex flex-wrap gap-4 text-sm font-medium">
      {p.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-accent decoration-2 underline-offset-4">
          {l.label}
        </a>
      ))}
    </div>
  )}
</article>
