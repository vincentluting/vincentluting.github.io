---
import Button from '../Button.astro';
import Tag from '../Tag.astro';
import type { Project } from '../../data/types';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const cs = p.caseStudy!;
---

<article id={p.id} class="scroll-mt-24">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow mb-3">Case study</p>
      <h2 class="text-4xl font-medium leading-tight md:text-5xl">{p.title}</h2>
      <p class="mt-2 italic text-muted">{p.kicker} · {p.period}</p>
      <p class="mt-6 leading-relaxed text-muted">{p.summary}</p>
      {p.stack && (
        <div class="mt-6 flex flex-wrap gap-2">
          {p.stack.map((s) => <Tag>{s}</Tag>)}
        </div>
      )}
      <div class="mt-8 flex flex-wrap gap-3">
        {p.links?.map((l) => <Button href={l.href} external>{l.label}</Button>)}
      </div>
      {p.metrics && (
        <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line">
          {p.metrics.map((m) => (
            <div class="bg-surface p-5">
              <dd class="font-display text-3xl font-medium md:text-4xl">{m.value}</dd>
              <dt class="mt-1 text-xs text-muted">{m.label}</dt>
            </div>
          ))}
        </dl>
      )}
    </div>

    <div class="space-y-10 lg:col-span-7">
      <div data-reveal>
        <h3 class="font-sans text-sm font-medium uppercase tracking-[0.14em]">The problem</h3>
        <p class="mt-3 leading-relaxed text-muted">{cs.problem}</p>
      </div>
      <div data-reveal style="--d: 80ms">
        <h3 class="font-sans text-sm font-medium uppercase tracking-[0.14em]">What I did</h3>
        <ol class="mt-3 space-y-3">
          {cs.approach.map((a, i) => (
            <li class="flex gap-4 leading-relaxed text-muted">
              <span class="font-display text-lg leading-none text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span>{a}</span>
            </li>
          ))}
        </ol>
      </div>
      <div data-reveal style="--d: 160ms">
        <h3 class="font-sans text-sm font-medium uppercase tracking-[0.14em]">Outcome</h3>
        <ul class="mt-3 space-y-2">
          {cs.outcome.map((o) => (
            <li class="flex gap-3 leading-relaxed text-muted">
              <span aria-hidden="true" class="mt-[0.7em] h-1 w-1 shrink-0 rounded-full bg-accent"></span>
              <span>{o}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</article>
