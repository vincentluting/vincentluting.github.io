---
import ThemeToggle from './ThemeToggle.astro';
import { site, cvUrl } from '../data';

const nav = [
  { label: 'Experience', href: '/experience/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Writing', href: '/posts/' },
  { label: 'About', href: '/about/' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="font-display text-lg font-medium tracking-tight text-ink">
      {site.name}<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm transition-colors hover:text-ink',
            isActive(item.href) ? 'text-ink underline decoration-accent decoration-2 underline-offset-8' : 'text-muted',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      {cvUrl && <a
        href={cvUrl}
        download
        class="hidden items-center gap-1.5 rounded-full border border-line px-3.5 py-1.5 text-sm text-ink transition-colors hover:border-ink sm:inline-flex"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path></svg>
        CV
      </a>}
      <ThemeToggle />
      <button
        type="button"
        data-nav-toggle
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-paper md:hidden" data-nav-panel>
    <nav class="container-page flex flex-col py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} class:list={['py-2.5 text-base', isActive(item.href) ? 'text-ink' : 'text-muted']}>
          {item.label}
        </a>
      ))}
      {cvUrl && <a href={cvUrl} download class="py-2.5 text-base text-accent">Download CV</a>}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
