---
import Seal from './ink/Seal.astro';
import { site, cvUrl } from '../data';
const year = new Date().getFullYear();

const links = [
  { label: 'Stories', href: '/stories/' },
  { label: 'Writing', href: '/posts/' },
  { label: 'About', href: '/about/' },
  { label: 'Now', href: '/now/' },
  { label: 'How I work', href: '/how-i-work/' },
  { label: 'Experience', href: '/experience/' },
];
---

<footer class="mt-8 border-t border-line">
  <div class="container-page grid gap-10 py-12 md:grid-cols-12">
    <div class="flex items-start gap-4 md:col-span-5">
      <Seal size={44} stamp />
      <div>
        <p class="font-display text-lg">{site.fullName}</p>
        <p class="mt-1 text-muted">{site.role} · {site.location}</p>
        <p class="mt-3 font-mono text-xs text-muted">
          Utrecht <span data-clock="Europe/Amsterdam">--:--</span>
          <span aria-hidden="true" class="mx-1.5">·</span>
          Shanghai <span data-clock="Asia/Shanghai">--:--</span>
        </p>
      </div>
    </div>
    <nav class="md:col-span-3" aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 font-mono text-[0.8rem]">
        {links.map((l) => (
          <li><a class="text-muted transition-colors hover:text-ink" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <ul class="flex flex-col gap-2 font-mono text-[0.8rem] md:col-span-4 md:items-end">
      <li><a class="text-muted transition-colors hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a class="text-muted transition-colors hover:text-ink" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      {cvUrl && <li><a class="text-muted transition-colors hover:text-ink" href={cvUrl} download>CV (PDF)</a></li>}
      <li><a class="text-muted transition-colors hover:text-ink" href="/rss.xml">RSS</a></li>
    </ul>
  </div>
  <div class="container-page pb-8 font-mono text-[0.7rem] text-muted">
    © {year} {site.name}. Made in Utrecht, with Astro.
  </div>
</footer>
