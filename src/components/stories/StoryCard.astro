---
import type { Story } from '../../lib/stories';
import { readingMinutes, storyTransition } from '../../lib/stories';

interface Props {
  story: Story;
  index?: number;
}
const { story, index = 0 } = Astro.props;
const { title, summary, company, period, tldr } = story.data;
const lead = tldr.numbers[0];
const href = `/stories/${story.id}/`;
const tilt = ['-0.4deg', '0.35deg', '-0.2deg', '0.5deg'][index % 4];
---

<div class="h-full" data-drop data-tilt>
<article
  class="group sheet relative flex h-full flex-col p-6 transition-[rotate,translate,box-shadow] duration-500 ease-out-soft hover:-translate-y-1 hover:rotate-0 hover:shadow-[0_1px_0_rgb(0_0_0/0.04),0_28px_50px_-26px_rgb(0_0_0/0.4)] md:p-7"
  style={`rotate: ${tilt}`}
  data-cursor="Read"
>
  <p class="eyebrow">{company} · {period}</p>
  <h3 class="mt-3 text-2xl font-medium leading-snug" style={`view-transition-name: ${storyTransition(story.id)}`}>
    <a href={href} class="after:absolute after:inset-0 group-hover:text-accent">{title}</a>
  </h3>
  <p class="mt-3 leading-relaxed text-muted">{summary}</p>
  <div class="mt-auto flex items-end justify-between gap-4 pt-6">
    {lead && (
      <p class="leading-tight">
        <span class="block font-display text-3xl font-medium text-accent">{lead.value}</span>
        <span class="font-mono text-[0.7rem] uppercase tracking-wider text-muted">{lead.label}</span>
      </p>
    )}
    <span class="shrink-0 font-mono text-[0.75rem] text-muted transition-colors group-hover:text-ink">
      {readingMinutes(story.body)} min read <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
    </span>
  </div>
</article>
</div>
