---
/**
 * A band of the page inside the content width. `rule` draws a hairline above
 * it that is exactly as wide as the content, so section dividers line up with
 * the text instead of overhanging it. Full-width lines are kept for the page
 * frame only: the bottom of the hero band and the top of the footer.
 */
interface Props {
  id?: string;
  class?: string;
  rule?: boolean;
}
const { id, class: className = '', rule = false } = Astro.props;
---

<section id={id} class:list={['container-page', id && 'scroll-mt-16', className]}>
  <div class:list={['py-12 md:py-16', rule && 'border-t border-line']}>
    <slot />
  </div>
</section>
