---
import { education } from '../../data/education';
---

<ol class="divide-y divide-line border-y border-line">
  {education.map((e, i) => (
    <li class="grid gap-2 py-6 md:grid-cols-12 md:gap-8" data-reveal style={`--d: ${i * 60}ms`}>
      <div class="md:col-span-3">
        <p class="text-sm font-medium text-ink">{e.years}</p>
        <p class="text-sm text-muted">{e.location}</p>
      </div>
      <div class="md:col-span-9">
        <h3 class="font-sans text-lg font-medium tracking-normal">
          {e.degree}{e.field && <span class="text-muted"> · {e.field}</span>}
        </h3>
        <p class="font-display text-xl">{e.school}</p>
        {e.note && <p class="mt-2 text-sm text-muted">{e.note}</p>}
      </div>
    </li>
  ))}
</ol>
